# Copy to .env (gitignored). Dev-only values.
LAE_DB_PASSWORD=lae_owner_dev
# the API/CLI run as the NON-superuser lae_app role (review M2); migrations use lae_owner
LAE_DATABASE_URL=postgresql+psycopg://lae_app:lae_app_dev@127.0.0.1:5433/lae
LAE_ADMIN_URL=postgresql+psycopg://lae_owner:lae_owner_dev@127.0.0.1:5433/lae
LAE_READER_URL=postgresql+psycopg://lae_reader:lae_reader_dev@127.0.0.1:5433/lae
LAE_TEST_DATABASE_URL=postgresql+psycopg://lae_owner:lae_owner_dev@127.0.0.1:5433/lae_test
LAE_TARGET_SCHEMAS=app
# generate: py -3.12 -c "import secrets;print(secrets.token_hex(32))"
LAE_HMAC_KEY=
LAE_SIGNING_KEY_PATH=secrets/signing_key.pem
LAE_API_TOKEN=
LAE_REQUIRE_FOUR_EYES=true
